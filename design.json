    "locationCard": {
      "background": "#FFFFFF",
      "borderRadius": "12px",
      "padding": "24px",
      "shadow": "0 2px 8px rgba(0,0,0,0.06)",
      "border": "1px solid #E8E8E8",
      "title": {
        "fontSize": "1.25rem",
        "fontWeight": "600",
        "color": "#005B96",
        "marginBottom": "12px"
      },
      "address": {
        "fontSize": "0.95rem",
        "color": "#4A4A4A",
        "lineHeight": "1.6"
      }
    },
    "statCard": {
      "background": "linear-gradient(135deg, #005B96, #003F6B)",
      "borderRadius": "12px",
      "padding": "32px",
      "textAlign": "center",
      "stat": {
        "fontSize": "2.5rem",
        "fontWeight": "700",
        "color": "#FFFFFF"
      },
      "label": {
        "fontSize": "1rem",
        "color": "rgba(255,255,255,0.85)",
        "marginTop": "8px"
      }
