    "transition": {
      "default": "all 0.3s ease",
      "hover": "transform 0.3s ease, box-shadow 0.3s ease"
    },
    "fadeIn": {
      "duration": "0.6s",
      "easing": "ease-out"
    },
    "slideUp": {
      "duration": "0.5s",
      "easing": "ease-out"
    }
