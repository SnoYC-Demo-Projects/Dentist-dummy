  "breakpoints": {
    "mobile": "320px",
    "tablet": "768px",
    "desktop": "1024px",
    "largeDesktop": "1440px"
  },
  "icons": {
    "style": "line-icons",
    "library": "Heroicons / Font Awesome",
    "color": "#005B96",
    "size": "24px"
  },
  "images": {
    "style": "professional-healthcare",
    "borderRadius": "8px",
    "overlay": "rgba(0,0,0,0.1)",
    "placeholder": "#E8E8E8"
