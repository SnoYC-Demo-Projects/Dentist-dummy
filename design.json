      "quote": {
        "fontSize": "1rem",
        "color": "#4A4A4A",
        "lineHeight": "1.7",
        "fontStyle": "italic",
        "margin": "16px 0"
      },
      "author": {
        "fontSize": "0.95rem",
        "fontWeight": "600",
        "color": "#1A1A1A"
      }
